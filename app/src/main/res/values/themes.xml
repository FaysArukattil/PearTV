<resources>
    <style name="Theme.LeanTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Theme.LeanTv.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0E12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/banner</item>
        <item name="postSplashScreenTheme">@style/Theme.LeanTv</item>
    </style>
</resources>
